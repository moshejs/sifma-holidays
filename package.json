{
  "name": "sifma-holidays",
  "version": "1.0.0",
  "description": "US bond-market holidays, early closes, and settlement dates per SIFMA recommendations. The fixed-income calendar (Columbus Day, Veterans Day, 2pm early closes) — not the stock market's. Zero dependencies.",
  "keywords": [
    "sifma",
    "holidays",
    "bond-market",
    "fixed-income",
    "treasury",
    "settlement",
    "business-days",
    "market-calendar",
    "trading-calendar",
    "early-close",
    "finance",
    "bonds"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/sifma-holidays.git"
  },
  "bugs": "https://github.com/moshejs/sifma-holidays/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
